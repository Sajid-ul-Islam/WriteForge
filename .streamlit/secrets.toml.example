[llm]
# Add your API keys below. You only need to provide the ones you want to use.
# Copy this file to secrets.toml and fill in your actual keys.
# NEVER commit secrets.toml — it is in .gitignore.

openrouter_key = "sk-or-v1-YOUR_KEY_HERE"
gemini_key     = "YOUR_GEMINI_KEY_HERE"
groq_key       = "gsk_YOUR_GROQ_KEY_HERE"
huggingface_key = "hf_YOUR_HF_KEY_HERE"
openai_key     = "sk-YOUR_OPENAI_KEY_HERE"
